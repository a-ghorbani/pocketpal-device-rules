    "_comment_layer_3": "Layer 3: CPU heuristic — runs only when Layer 1+2 miss. Rules evaluated top-to-bottom, first match wins. Anchored on llama.cpp's actual dispatch signals (i8mm/dotprod) and on big-core clock as a thermal/silicon-class proxy.",
    "cpu_heuristic": {
      "rules": [
        {
          "match": { "features_any": ["i8mm"] },
          "class": "flagship",
          "rationale": "ARMv8.6+/v9 chips with i8mm are 2022+ flagship-class; llama.cpp uses i8mm kernels here"
        },
        {
          "match": { "features_any": ["sve2"] },
          "class": "flagship",
          "rationale": "SVE2 implies ARMv9 — flagship silicon"
        },
        {
          "match": { "max_freq_mhz_min": 3000 },
          "class": "flagship",
          "rationale": ">= 3.0 GHz big-core sustained clock indicates flagship thermal/silicon class"
        },
        {
          "match": { "features_all": ["dotprod"], "max_freq_mhz_min": 2400 },
          "class": "mid",
          "rationale": "ARMv8.2+ dotprod with capable clock = mid-range silicon"
        },
        {
          "match": { "features_all": ["dotprod"] },
          "class": "mid",
          "rationale": "Has dotprod but lower clock — conservative mid (older big-A75/A76 phones)"
        },
        {
          "match": {},
          "class": "budget",
          "rationale": "Default — pre-ARMv8.2 chip, or unable to read CPU info"
        }
      ]
    },

    "_comment_matrix": "Tier matrix: (ram_band × soc_class) → tier_id. Lookup unknowns: missing SoC class is treated as 'budget' for safety. Reported RAM ≪ nominal RAM (8 GiB phones report ~6.9-7.4 GiB; 12 GiB phones report ~10.3-11.3 GiB) — bands are tuned for reported values.",
    "tier_matrix": [
